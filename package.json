{
  "name": "loadstone",
  "private": true,
  "scripts": {
    "check": "pnpm run check-types && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build",
    "build": "vp run -r build",
    "dev": "pnpm --filter loadstone-rs3 dev",
    "start": "pnpm --filter loadstone-rs3 start",
    "tui": "pnpm --filter loadstone-tui start",
    "dev:tui": "pnpm --filter loadstone-tui dev",
    "desktop": "pnpm --filter loadstone-desktop start",
    "desktop:package": "pnpm --filter loadstone-desktop package",
    "desktop:make": "pnpm --filter loadstone-desktop make",
    "desktop:smoke": "pnpm --filter loadstone-desktop smoke",
    "lint": "vp lint --deny-warnings --report-unused-disable-directives-severity error",
    "check-types": "pnpm -r check-types",
    "test": "vp run -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "format": "vp fmt",
    "format:check": "vp fmt --check"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.19.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.34.8"
}

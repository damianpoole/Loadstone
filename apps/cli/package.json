{
  "name": "loadstone-rs3",
  "version": "0.0.2",
  "description": "CLI for accessing the RuneScape 3 Wiki",
  "bin": {
    "loadstone": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "scripts": {
    "build": "vp pack",
    "start": "vp pack && node dist/index.js",
    "dev": "vp pack --watch",
    "lint": "vp lint",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@loadstone/tsconfig": "workspace:*",
    "@loadstone/wiki-client": "workspace:*",
    "@types/node": "^24.0.0",
    "chalk": "^4.1.2",
    "commander": "^13.1.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.19.0 || >=26.0.0"
  }
}
